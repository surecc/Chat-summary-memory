.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0;
}

.thumb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f0f1f3;
}

.thumb image {
  width: 100%;
  height: 100%;
}

.thumb-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #8a8f99;
  border: 2rpx dashed #d0d3d9;
  box-sizing: border-box;
}

.thumb-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}
