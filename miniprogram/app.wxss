page {
  background: #f6f7f9;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #8a8f99;
  font-size: 26rpx;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  background: #9be6bf;
  color: #ffffff;
}
